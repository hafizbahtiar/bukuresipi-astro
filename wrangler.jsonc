{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bukuresipi-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  // Static Astro build. run_worker_first so the www redirect also covers paths that match a file.
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  // Custom domains: `wrangler deploy` creates the DNS records + certificates (zone bukuresipi.com is on this account).
  // The API is the other Worker (bukuresipi-hono) on api.bukuresipi.com.
  "routes": [
    { "pattern": "bukuresipi.com", "custom_domain": true },
    { "pattern": "www.bukuresipi.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
