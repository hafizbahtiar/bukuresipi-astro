---
// /family/join?t=<token>: the family invite link. With the app installed, Android opens the app (App Link) and this
// page is never shown. Without it: what a family is and how to join. The token stays in the URL only: this page never
// reads or sends it (noindex = no-referrer, so fonts and stores never see it).
import Base from "../layouts/Base.astro";
import { type Lang, t } from "../i18n";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import StoreBadges from "./StoreBadges.astro";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).family;
---

<Base
    lang={lang}
    path="/family/join"
    title={`${s.title} - Bukuresipi`}
    description={s.lead}
    noindex
>
    <Header lang={lang} path="/family/join" />
    <main class="wrap join">
        <h1>{s.h1}</h1>
        <p class="lead">{s.lead}</p>
        <a class="open-app" id="open-app" hidden>{s.openApp}</a>
        <ol>
            {
                s.steps.map(([title, text]) => (
                    <li>
                        <>
                            <h2>{title}</h2>
                            <p>{text}</p>
                        </>
                    </li>
                ))
            }
        </ol>
        <StoreBadges lang={lang} />
        <p class="note">{s.note}</p>
    </main>
    <Footer lang={lang} />
</Base>

<script>
    // The language switch keeps the invite token, so the other-language page is the same link.
    const other = document.querySelector<HTMLAnchorElement>(".site-head .lang");
    if (other && location.search) other.search = location.search;

    // Android: an intent link to the app itself. Chrome opens it in Bukuresipi even when Android has not verified the
    // App Link (or the link was opened in a browser); without the app, Android offers the Play Store.
    const open = document.querySelector<HTMLAnchorElement>("#open-app");
    if (open && /Android/i.test(navigator.userAgent)) {
        open.href = `intent://${location.host}${location.pathname}${location.search}#Intent;scheme=https;package=com.bukuresipi;end`;
        open.hidden = false;
    }
</script>

<style>
    .join {
        max-width: 42rem;
        padding-block: clamp(2.5rem, 8vw, 5rem);
    }
    h1 {
        font-size: var(--step-3);
    }
    .lead {
        margin-block: 1rem 2rem;
        font-size: var(--step-1);
        line-height: 1.45;
        color: var(--ink-soft);
    }
    .open-app {
        display: inline-block;
        margin-bottom: 2rem;
        padding: 0.8rem 1.4rem;
        border-radius: 999px;
        background: var(--ink);
        color: var(--paper);
        font-weight: 700;
        text-decoration: none;
    }
    .open-app[hidden] {
        display: none;
    }
    ol {
        display: grid;
        gap: 1.25rem;
        margin: 0 0 2rem;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
    }
    li {
        padding-top: 1.25rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: 1.25rem;
    }
    h2 {
        margin-bottom: 0.35rem;
        font-size: var(--step-1);
    }
    li p {
        color: var(--ink-soft);
    }
    .note {
        margin-top: 1.5rem;
        font-size: var(--step--1);
        color: var(--ink-soft);
    }
</style>
