---
// Store buttons. Until STORES has a link they render as disabled "coming soon" badges. Text only: at launch, swap in
// the official Google Play / App Store badge artwork (their brand rules forbid redrawing the logos).
import { type Lang, STORES, t } from "../i18n";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).home;
const stores = [
    { name: s.play, href: STORES.play, note: s.soon },
    { name: s.appStore, href: STORES.appStore, note: s.iosNote },
];
---

<div class="badges">
    {
        stores.map((st) =>
            st.href ? (
                <a class="badge" href={st.href}>
                    <span>
                        <small>
                            {lang === "en" ? "Get it on" : "Dapatkan di"}
                        </small>
                        {st.name}
                    </span>
                </a>
            ) : (
                <span class="badge soon" aria-disabled="true">
                    <span>
                        <small>{st.note}</small>
                        {st.name}
                    </span>
                </span>
            ),
        )
    }
</div>

<style>
    .badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }
    .badge {
        display: inline-flex;
        align-items: center;
        min-width: 10.5rem;
        padding: 0.45rem 0.9rem;
        border: 2px solid var(--ink);
        border-radius: 3px;
        color: var(--ink);
        line-height: 1.15;
        font-size: 1.05rem;
        font-weight: 600;
    }
    a.badge {
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }
    a.badge:hover {
        background: var(--ink);
        color: var(--paper);
    }
    .badge small {
        display: block;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        opacity: 0.65;
    }
    .soon {
        border-style: dashed;
        cursor: default;
    }
</style>
