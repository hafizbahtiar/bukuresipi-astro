---
// Store buttons. Until STORES has a link they render as disabled "coming soon" badges. Text only: at launch, swap in
// the official Google Play / App Store badge artwork (their brand rules forbid redrawing the logos).
import { type Lang, STORES, t } from '../i18n'

interface Props { lang: Lang; tone?: 'light' | 'dark' }
const { lang, tone = 'dark' } = Astro.props
const s = t(lang).home
const stores = [
    { name: s.play, href: STORES.play },
    { name: s.appStore, href: STORES.appStore },
]
---

<div class:list={['badges', tone]}>
    {stores.map(st => st.href
        ? <a class="badge" href={st.href}><span><small>{lang === 'en' ? 'Get it on' : 'Dapatkan di'}</small>{st.name}</span></a>
        : <span class="badge soon" aria-disabled="true"><span><small>{s.soon}</small>{st.name}</span></span>)}
</div>

<style>
    .badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        min-width: 10rem;
        padding: 0.6rem 1.1rem 0.6rem 0.9rem;
        border-radius: 14px;
        background: var(--ink);
        color: #fff;
        text-decoration: none;
        line-height: 1.1;
        font-size: 1.15rem;
        font-weight: 600;
    }
    .badge small {
        display: block;
        font-size: 0.72rem;
        font-weight: 500;
        opacity: 0.8;
    }
    .soon {
        cursor: default;
    }
    .light .badge {
        background: #fff;
        color: var(--pandan-deep);
    }
</style>
