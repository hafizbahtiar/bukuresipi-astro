---
import Base from "../layouts/Base.astro";
import { type Lang, pathIn, SITE, t } from "../i18n";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import StoreBadges from "./StoreBadges.astro";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).home;
const n = s.notebook;

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Bukuresipi",
        url: SITE,
        logo: `${SITE}/icon-512.png`,
    },
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Bukuresipi",
        url: `${SITE}${pathIn("/", lang)}`,
        inLanguage: lang,
    },
    {
        "@context": "https://schema.org",
        "@type": "MobileApplication",
        name: "Bukuresipi",
        operatingSystem: "Android",
        applicationCategory: "LifestyleApplication",
        description: s.description,
        inLanguage: ["ms", "en"],
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: s.faq.map(([q, a]) => ({
            "@type": "Question",
            name: q,
            acceptedAnswer: { "@type": "Answer", text: a },
        })),
    },
];
---

<Base
    lang={lang}
    path="/"
    title={s.title}
    description={s.description}
    jsonLd={jsonLd}
>
    <Header lang={lang} path="/" nav />
    <main class="home">
        <section class="wrap hero">
            <div class="hero-copy">
                <p class="eyebrow">{s.eyebrow}</p>
                <h1>{s.h1}</h1>
                <p class="lead">{s.lead}</p>
                <StoreBadges lang={lang} />
                <a class="tester-link" href="#tester"
                    >{s.tester.hero}
                    <span aria-hidden="true">→</span></a
                >
            </div>

            <figure class="book" aria-label={s.ogAlt}>
                <div class="page" aria-hidden="true">
                    <p class="chip">
                        <span class="chip-dot"
                        ></span>tiktok.com/@dapurkakna/video/7426…
                    </p>
                    <p class="dish">{n.dish}</p>
                    <ul class="hand">
                        {
                            n.lines.map(([qty, rest]) => (
                                <li>
                                    <mark>{qty}</mark>
                                    {rest}
                                </li>
                            ))
                        }
                        <li class="gap">{n.gap}</li>
                    </ul>
                    <div class="pin">
                        <svg viewBox="0 0 24 24" class="pin-icon"
                            ><path
                                d="M12 2a7 7 0 0 1 7 7c0 5.2-7 13-7 13S5 14.2 5 9a7 7 0 0 1 7-7z"
                                fill="#d23c35"></path><circle
                                cx="12"
                                cy="9"
                                r="2.6"
                                fill="#fff"></circle></svg
                        >
                        <div>
                            <p class="pin-name">{n.place}</p>
                            <p class="pin-area">{n.area}</p>
                            <p class="pin-halal">
                                <mark>{n.halal}</mark>
                                <span>{n.halalSource}</span>
                            </p>
                        </div>
                    </div>
                </div>
            </figure>
        </section>

        <section id="cara" class="steps-band">
            <div class="wrap">
                <h2>{s.stepsTitle}</h2>
                <div class="how">
                    <ol class="steps">
                        {
                            s.steps.map(([title, text]) => (
                                <li>
                                    <>
                                        <h3>{title}</h3>
                                        <p>{text}</p>
                                    </>
                                </li>
                            ))
                        }
                    </ol>
                    <!-- Made by `bun run video` (scripts/video.ts). Silent: the steps beside it carry the same words. -->
                    <video
                        class="how-video"
                        poster={`/video/how-it-works-${lang}.webp`}
                        width="1080"
                        height="1080"
                        muted
                        loop
                        playsinline
                        controls
                        preload="none"
                        aria-label={s.stepsTitle}
                    >
                        <!-- The browser takes the first it can play: AV1 (smaller), else H.264. -->
                        <source
                            src={`/video/how-it-works-${lang}.webm`}
                            type='video/webm; codecs="av01.0.08M.08, opus"'
                        />
                        <source
                            src={`/video/how-it-works-${lang}.mp4`}
                            type="video/mp4"
                        />
                    </video>
                </div>
            </div>
        </section>

        <section class="wrap duo">
            <div>
                <h2><span class="hl">{s.bookTitle}</span></h2>
                <p>{s.bookText}</p>
            </div>
            <div>
                <h2><span class="hl">{s.mapTitle}</span></h2>
                <p>{s.mapText}</p>
            </div>
        </section>

        <section class="wrap honest">
            <h2>{s.honestTitle}</h2>
            <p class="honest-lead">{s.honestLead}</p>
            <dl>
                {
                    s.honest.map(([term, text]) => (
                        <div>
                            <>
                                <dt>{term}</dt>
                                <dd>{text}</dd>
                            </>
                        </div>
                    ))
                }
            </dl>
        </section>

        <section class="wrap platforms" aria-labelledby="works-with">
            <h2 id="works-with">{s.worksWith}</h2>
            <ul>{s.platforms.map((p) => <li>{p}</li>)}</ul>
        </section>

        <section id="soalan" class="wrap faq">
            <h2><span class="hl">{s.faqTitle}</span></h2>
            <div class="faq-list">
                {
                    s.faq.map(([q, a]) => (
                        <details>
                            <>
                                <summary>
                                    <span class="q">{q}</span>
                                </summary>
                                <p>{a}</p>
                            </>
                        </details>
                    ))
                }
            </div>
        </section>

        <section class="cta" id="tester">
            <div class="wrap">
                <div class="cta-page">
                    <h2>{s.ctaTitle}</h2>
                    <p>{s.ctaText}</p>
                    <form
                        class="tester"
                        novalidate
                        data-lang={lang}
                        data-invalid={s.tester.invalid}
                        data-done={s.tester.done}
                        data-disposable={s.tester.disposable}
                        data-rate={s.tester.rate}
                        data-network={s.tester.network}
                    >
                        <h3 class="tester-title">
                            {s.tester.title}
                        </h3>
                        <p class="tester-text">{s.tester.text}</p>
                        <div class="tester-row">
                            <label class="visually-hidden" for="tester-email"
                                >{s.tester.label}</label
                            >
                            <input
                                id="tester-email"
                                type="email"
                                name="email"
                                autocomplete="email"
                                maxlength="254"
                                placeholder={s.tester.placeholder}
                                required
                            />
                            <button type="submit">{s.tester.button}</button>
                        </div>
                        <p class="tester-note">{s.tester.note}</p>
                        <p
                            class="tester-status"
                            role="status"
                            aria-live="polite"
                        >
                        </p>
                    </form>
                </div>
            </div>
        </section>
    </main>
    <Footer lang={lang} nav />
</Base>

<style>
    .home {
        --page-indent: clamp(1.5rem, 4vw, 2.75rem);
        padding-block: 0;
        /* The tilted book's back page pokes past the edge on phones; clip (not hidden) keeps no scroll container. */
        overflow-x: clip;
    }
    .hl {
        background: linear-gradient(
            transparent 56%,
            color-mix(in srgb, var(--kunyit) 62%, transparent) 56% 92%,
            transparent 92%
        );
        padding-inline: 0.08em;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: center;
        padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 5.5rem);
        padding-left: var(--page-indent);
    }
    /* Grid children may shrink below their content (the link chip never wraps). */
    .hero > *,
    .duo > * {
        min-width: 0;
    }
    .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin-bottom: 1.1rem;
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
    }
    .eyebrow::before {
        content: "";
        width: 1.8rem;
        height: 1px;
        background: var(--margin);
    }
    h1 {
        font-size: var(--step-4);
        max-width: 14ch;
    }
    .lead {
        margin-block: 1.35rem 1.9rem;
        max-width: 30em;
        font-size: var(--step-1);
        line-height: 1.45;
        color: var(--ink-soft);
    }
    .tester-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 1rem;
        padding-bottom: 0.1rem;
        color: var(--pandan-deep);
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1.5px solid var(--margin);
        transition:
            color 0.2s ease,
            border-color 0.2s ease;
    }
    .tester-link:hover {
        color: var(--margin);
        border-color: var(--pandan);
    }

    /* The exercise book: blue rules, red margin, a pasted link and the recipe written in by hand. */
    .book {
        position: relative;
        margin: 0;
        justify-self: center;
        width: min(100%, 470px);
        transform: rotate(0.9deg);
        animation: settle 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .book::before {
        content: "";
        position: absolute;
        inset: 0.55rem -0.45rem -0.6rem 0.5rem;
        z-index: -1;
        border-radius: 6px 18px 18px 6px;
        background: var(--paper-raised);
        box-shadow: 4px 6px 0 rgba(28, 42, 32, 0.09);
        transform: rotate(-1.4deg);
    }
    .page {
        --lh: 2.05rem;
        position: relative;
        padding: 1.6rem 1.6rem 1.8rem 4.2rem;
        border-radius: 6px 18px 18px 6px;
        background:
            linear-gradient(
                90deg,
                transparent 3rem,
                var(--margin) 3rem,
                var(--margin) calc(3rem + 2px),
                transparent calc(3rem + 2px)
            ),
            repeating-linear-gradient(
                transparent 0 calc(var(--lh) - 1px),
                var(--rule) calc(var(--lh) - 1px) var(--lh)
            ),
            var(--paper-raised);
        background-position:
            0 0,
            0 1.45rem,
            0 0;
        border-left: 10px solid var(--pandan);
        box-shadow: 6px 8px 0 rgba(28, 42, 32, 0.08);
        line-height: var(--lh);
    }
    .page::before {
        content: "";
        position: absolute;
        top: 0.8rem;
        bottom: 0.8rem;
        left: -7px;
        width: 2px;
        background: repeating-linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.55) 0 0.5rem,
            transparent 0.5rem 1rem
        );
        pointer-events: none;
    }
    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        max-width: 100%;
        margin-bottom: 0.4rem;
        padding: 0.1rem 0.75rem;
        line-height: 1.8;
        border-radius: 999px;
        background: var(--ink);
        color: #fff;
        font-size: 0.82rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transform: rotate(-1.5deg);
    }
    .chip-dot {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--kunyit);
        flex: none;
    }
    .dish {
        font-family: var(--hand);
        font-weight: 700;
        font-size: 2.15rem;
        color: var(--pandan-deep);
        text-decoration: underline 2px var(--margin);
        text-underline-offset: 0.25em;
    }
    .hand {
        margin: 0;
        padding: 0;
        list-style: none;
        font-family: var(--hand);
        font-size: 1.55rem;
        color: #24334f;
    }
    .hand li::before {
        content: "- ";
    }
    mark {
        background: linear-gradient(
            transparent 22%,
            color-mix(in srgb, var(--kunyit) 75%, transparent) 22% 88%,
            transparent 88%
        );
        color: inherit;
        padding-inline: 0.12em;
    }
    .gap {
        color: #8a93a6;
        font-style: italic;
    }
    .pin {
        display: flex;
        gap: 0.7rem;
        margin-top: 0.9rem;
        padding: 0.85rem 1rem;
        border-radius: 6px;
        background: var(--pandan-mist);
        line-height: 1.35;
        transform: rotate(-1deg);
    }
    .pin-icon {
        width: 30px;
        height: 30px;
        flex: none;
    }
    .pin-name {
        font-weight: 700;
    }
    .pin-area {
        font-size: 0.85rem;
        color: var(--ink-soft);
    }
    .pin-halal {
        margin-top: 0.35rem;
        font-size: 0.9rem;
    }
    .pin-halal span {
        color: var(--ink-soft);
        font-size: 0.8rem;
    }

    /* The book settles onto the page once; nothing in it is hidden behind a reveal. */
    @keyframes settle {
        from {
            opacity: 0;
            transform: translateY(14px) rotate(0.9deg);
        }
        to {
            opacity: 1;
            transform: translateY(0) rotate(0.9deg);
        }
    }

    .steps-band {
        padding-block: clamp(3rem, 7vw, 5.5rem);
        background-color: var(--pandan-deep);
        background-image: repeating-linear-gradient(
            180deg,
            transparent 0 2.4rem,
            rgba(255, 255, 255, 0.045) 2.4rem calc(2.4rem + 1px)
        );
        color: #fff;
    }
    .steps-band .wrap {
        padding-left: var(--page-indent);
    }
    .steps-band h2,
    .duo h2,
    .faq h2 {
        font-size: var(--step-3);
    }
    .how {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: start;
        margin-top: 2.25rem;
    }
    .how-video {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 14px;
        background: var(--paper);
        box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.55);
    }
    .steps {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: step;
        border-top: 1px solid rgba(255, 255, 255, 0.22);
    }
    .steps li {
        display: grid;
        grid-template-columns: 4.5rem minmax(0, 1fr);
        column-gap: clamp(1rem, 3vw, 2.5rem);
        align-items: start;
        padding-block: 1.35rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.22);
        counter-increment: step;
    }
    .steps li::before {
        content: counter(step, decimal-leading-zero);
        grid-row: 1 / span 2;
        font-family: var(--hand);
        font-weight: 700;
        font-size: 2.5rem;
        line-height: 1;
        color: var(--kunyit);
    }
    .steps h3 {
        grid-column: 2;
        margin-bottom: 0.3rem;
        font-size: var(--step-2);
    }
    .steps p {
        grid-column: 2;
        max-width: 46em;
        color: rgba(255, 255, 255, 0.8);
    }

    .duo {
        display: grid;
        grid-template-columns: 1fr 1fr;
        padding-block: clamp(3rem, 7vw, 5rem) 0;
        padding-left: var(--page-indent);
    }
    .duo > div {
        display: flex;
        flex-direction: column;
        padding-block: 1.35rem 0.9rem;
        border-top: 1.5px solid var(--ink);
    }
    .duo > div:first-child {
        padding-right: clamp(1.5rem, 4vw, 3.5rem);
        border-right: 1px solid var(--line);
    }
    .duo > div + div {
        padding-left: clamp(1.5rem, 4vw, 3.5rem);
    }
    .duo h2 {
        font-size: var(--step-2);
    }
    .duo p {
        margin-top: 0.85rem;
        max-width: 32em;
        color: var(--ink-soft);
    }

    .honest {
        margin-block: clamp(3rem, 7vw, 5rem);
        padding: clamp(1.5rem, 4vw, 2.25rem) 0 clamp(1.5rem, 4vw, 2.25rem)
            var(--page-indent);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }
    .honest h2 {
        font-family: var(--hand);
        font-weight: 700;
        font-size: clamp(2.3rem, 4.5vw, 3.3rem);
        line-height: 1;
        letter-spacing: 0;
        color: var(--pandan-deep);
    }
    .honest-lead {
        margin-top: 0.9rem;
        max-width: 38em;
        font-size: var(--step-1);
        line-height: 1.45;
    }
    .honest dl {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem 3rem;
        margin: 2rem 0 0;
    }
    .honest dt {
        font-weight: 700;
    }
    .honest dt::before {
        content: "*";
        margin-right: 0.25rem;
        font-family: var(--hand);
        font-size: 1.5em;
        color: var(--margin);
    }
    .honest dd {
        margin: 0.35rem 0 0;
        color: var(--ink-soft);
    }

    .platforms {
        padding-block: clamp(2.5rem, 6vw, 4rem) 0;
        padding-left: var(--page-indent);
    }
    .platforms h2 {
        font-family: var(--hand);
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: 0;
        text-transform: none;
        color: var(--pandan-deep);
    }
    .platforms ul {
        margin: 0.55rem 0 0;
        padding: 0;
        list-style: none;
    }
    .platforms li {
        display: inline;
        font-weight: 600;
    }
    .platforms li:not(:last-child)::after {
        content: ", ";
        color: var(--ink-soft);
        font-weight: 400;
    }

    .faq {
        padding-block: clamp(3rem, 7vw, 5rem);
        padding-left: var(--page-indent);
    }
    .faq-list {
        max-width: none;
        margin-top: 1.75rem;
        border-top: 1px solid var(--line);
        counter-reset: q;
    }
    details {
        border-bottom: 1px solid var(--line);
        counter-increment: q;
    }
    summary {
        display: grid;
        grid-template-columns: 2.75rem minmax(0, 1fr) 2rem;
        align-items: baseline;
        padding-block: 1.1rem;
        font-size: var(--step-1);
        font-weight: 600;
        cursor: pointer;
        list-style: none;
        transition: color 0.2s ease;
    }
    summary::-webkit-details-marker {
        display: none;
    }
    summary::before {
        content: counter(q, decimal-leading-zero);
        font-family: var(--hand);
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1;
        color: var(--margin);
    }
    summary .q {
        grid-column: 2;
    }
    summary::after {
        content: "+";
        grid-column: 3;
        justify-self: end;
        font-family: var(--hand);
        font-size: 1.8rem;
        line-height: 1;
        color: var(--pandan);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    summary:hover {
        color: var(--pandan-deep);
    }
    /* .closing: still open while it slides shut (the script removes [open] at the end). */
    details[open]:not(.closing) summary::after {
        transform: rotate(45deg);
    }
    details p {
        padding-left: 2.75rem;
        padding-bottom: 1.25rem;
        max-width: 40em;
        color: var(--ink-soft);
    }

    .cta {
        padding-block: clamp(2.5rem, 6vw, 4.5rem);
        background: var(--pandan-deep);
    }
    .cta-page {
        --margin-x: 2.9rem;
        position: relative;
        max-width: 46rem;
        margin-inline: auto;
        padding: clamp(1.5rem, 5vw, 2.5rem) clamp(1.5rem, 5vw, 2.5rem)
            clamp(2.25rem, 5vw, 3rem) calc(var(--margin-x) + 1.6rem);
        border-radius: 5px 16px 16px 5px;
        border-left: 9px solid var(--pandan);
        background-color: var(--paper-raised);
        background-image: linear-gradient(
            90deg,
            transparent var(--margin-x),
            var(--margin) var(--margin-x),
            var(--margin) calc(var(--margin-x) + 1.5px),
            transparent calc(var(--margin-x) + 1.5px)
        );
        box-shadow: 8px 10px 0 rgba(0, 0, 0, 0.16);
    }
    .cta-page::before {
        content: "";
        position: absolute;
        top: -1px;
        right: clamp(1.5rem, 5vw, 3rem);
        width: 18px;
        height: 58px;
        background: var(--kunyit);
        clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
        filter: drop-shadow(0 1px 0 rgba(28, 42, 32, 0.15));
        pointer-events: none;
    }
    .cta-page h2 {
        font-size: var(--step-3);
        max-width: 20ch;
    }
    .cta-page p {
        margin-block: 0.75rem 1.5rem;
        max-width: 34em;
        color: var(--ink-soft);
    }
    .tester {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1.5px dashed var(--line);
    }
    .tester-title {
        font-family: var(--hand);
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.1;
        color: var(--pandan-deep);
    }
    .tester-text {
        margin-top: 0.4rem;
        max-width: 40em;
        font-size: var(--step--1);
        color: var(--ink-soft);
    }
    .tester-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 0.75rem;
        margin-top: 1rem;
    }
    .tester-row input {
        flex: 1 1 12rem;
        min-width: 0;
        padding: 0.55rem 0;
        border: 0;
        border-bottom: 1.5px solid var(--ink);
        border-radius: 0;
        background: transparent;
        font: inherit;
        color: var(--ink);
    }
    .tester-row input::placeholder {
        color: var(--ink-soft);
        opacity: 0.7;
    }
    .tester-row button {
        flex: none;
        padding: 0.6rem 1rem;
        border: 2px solid var(--ink);
        border-radius: 3px;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: var(--step--1);
        font-weight: 700;
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }
    .tester-row button:hover {
        background: var(--ink);
        color: var(--paper);
    }
    .tester-note {
        margin-top: 0.7rem;
        font-size: 0.82rem;
        color: var(--ink-soft);
    }
    .tester-status {
        margin-top: 0.5rem;
        font-size: var(--step--1);
        font-weight: 600;
        color: var(--ink-soft);
    }
    .tester-status:empty {
        display: none;
    }
    .tester-status[data-tone="bad"] {
        color: var(--margin);
    }
    .tester-status[data-tone="ok"] {
        color: var(--pandan);
    }

    @media (max-width: 880px) {
        .how {
            grid-template-columns: minmax(0, 1fr);
        }
        .how-video {
            max-width: 30rem;
        }
        .hero,
        .duo,
        .honest dl {
            grid-template-columns: 1fr;
        }
        .duo > div:first-child {
            padding-right: 0;
            border-right: 0;
        }
        .duo > div + div {
            padding-left: 0;
        }
    }
    @media (max-width: 640px) {
        .cta-page::before {
            display: none;
        }
        .steps li {
            grid-template-columns: 2.75rem minmax(0, 1fr);
            column-gap: 0.9rem;
        }
        .steps li::before {
            font-size: 2rem;
        }
        summary {
            grid-template-columns: 2rem minmax(0, 1fr) 1.75rem;
        }
        details p {
            padding-left: 2rem;
        }
    }
    @media (max-width: 480px) {
        /* Phones: the gutter is margin enough; the extra indent only narrows the text. */
        .home {
            --page-indent: 0px;
        }
        .cta-page {
            --margin-x: 2rem;
        }
    }
    @media (max-width: 420px) {
        .page {
            padding-left: 3.4rem;
            background-position:
                -0.6rem 0,
                0 1.45rem,
                0 0;
        }
        .hand {
            font-size: 1.35rem;
        }
    }
</style>

<script>
    const tester = document.querySelector<HTMLFormElement>(".tester");
    if (tester) {
        const status = tester.querySelector<HTMLElement>(".tester-status")!;
        const button = tester.querySelector<HTMLButtonElement>("button")!;
        const say = (key: string, tone: string) => {
            status.textContent = tester.dataset[key] ?? "";
            status.dataset.tone = tone;
        };
        tester.addEventListener("submit", async (event) => {
            event.preventDefault();
            const email = tester.querySelector<HTMLInputElement>(
                'input[type="email"]',
            )!;
            if (!email.value.trim() || !email.checkValidity()) {
                say("invalid", "bad");
                email.focus();
                return;
            }
            button.disabled = true;
            try {
                // Same origin: the website Worker passes /api/* to the API Worker (service binding).
                const res = await fetch("/api/v1/testers", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        email: email.value.trim(),
                        lang: tester.dataset.lang,
                    }),
                });
                if (res.ok) {
                    say("done", "ok");
                    email.value = "";
                    return;
                }
                const { error } = (await res.json().catch(() => ({}))) as {
                    error?: string;
                };
                say(
                    error === "disposable_email"
                        ? "disposable"
                        : error === "rate_limited"
                          ? "rate"
                          : "invalid",
                    "bad",
                );
            } catch {
                say("network", "bad");
            } finally {
                button.disabled = false;
            }
        });
    }

    // FAQ: slide open and shut in every browser (a plain <details> jumps). The script animates the height of the whole
    // <details>; [open] stays on until a close finishes. Reduced motion or no script: the plain jump.
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    for (const details of document.querySelectorAll<HTMLDetailsElement>(
        ".faq details",
    )) {
        const summary = details.querySelector("summary")!;
        let anim: Animation | null = null;
        summary.addEventListener("click", (event) => {
            if (still.matches) return;
            event.preventDefault();
            const from = details.getBoundingClientRect().height; // mid-slide when clicked again
            anim?.cancel();
            const closing =
                details.open && !details.classList.contains("closing");
            details.classList.toggle("closing", closing);
            details.open = true;
            const border = details.offsetHeight - details.clientHeight;
            const to = closing
                ? summary.offsetHeight + border
                : details.offsetHeight;
            details.style.overflow = "hidden";
            anim = details.animate(
                { height: [`${from}px`, `${to}px`] },
                { duration: 320, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
            );
            anim.onfinish = () => {
                anim = null;
                details.style.overflow = "";
                if (closing) details.open = false;
                details.classList.remove("closing");
            };
        });
    }

    // "How it works" video: plays (muted, looping) only while on screen; reduced motion = stays on its poster.
    const how = document.querySelector<HTMLVideoElement>(".how-video");
    if (how && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        new IntersectionObserver(
            ([e]) =>
                e.isIntersecting ? how.play().catch(() => {}) : how.pause(),
            { threshold: 0.4 },
        ).observe(how);
    }
</script>
