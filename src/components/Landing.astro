<script>
    const reveals = document.querySelectorAll<HTMLElement>(".reveal");
    if (
        reveals.length &&
        "IntersectionObserver" in window &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
        document.documentElement.classList.add("js");
        const io = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("in");
                    io.unobserve(entry.target);
                }
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
        );
        reveals.forEach((el) => io.observe(el));
    }

    const tester = document.querySelector<HTMLFormElement>(".tester");
    if (tester) {
        const status = tester.querySelector<HTMLElement>(".tester-status")!;
        tester.addEventListener("submit", (event) => {
            event.preventDefault();
            const email = tester.querySelector<HTMLInputElement>(
                'input[type="email"]',
            )!;
            if (!email.value.trim() || !email.checkValidity()) {
                status.textContent = tester.dataset.invalid ?? "";
                status.dataset.tone = "bad";
                email.focus();
                return;
            }
            // Backend later: POST this email to the tester endpoint.
            status.textContent = tester.dataset.pending ?? "";
            status.dataset.tone = "";
        });
    }
</script>
